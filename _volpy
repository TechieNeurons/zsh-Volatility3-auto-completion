#compdef vol.py

_vol_plugins() {
    local VOL_PATH="/opt/volatility3/vol.py"

    local -a plugins matches
    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | awk '/^  +[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+/ {print $1}' | sed 's/\.$//'))
    fi

    local cur="${words[CURRENT]}"

    # 1. Handle the "Level Transition" (li -> linux -> linux.)
    # If the current word is a complete segment that has children, FORCE the dot.
    if [[ -n "${_vol_plugin_list[(r)$cur.*]}" ]]; then
        # -S "." adds the dot.
        # -n tells Zsh NOT to add a space.
        compadd -S "." -n -- "$cur"
        return
    fi

    # 2. Handle sub-level completion
    compset -P "*."

    # Filter for items at the current depth
    for p in $_vol_plugin_list; do
        if [[ "$p" == "$IPREFIX"* ]]; then
            local rest="${p#$IPREFIX}"
            matches+=("${rest%%.*}")
        fi
    done

    matches=(${(u)matches})

    if (( ${#matches} == 1 )); then
        local item="$matches[1]"
        local full_path="$IPREFIX$item"

        # Check if another level exists below this one
        if [[ -n "${_vol_plugin_list[(r)$full_path.*]}" ]]; then
            # More levels: Force a dot, no space allowed.
            compadd -S "." -n -- "$item"
        else
            # Final level: Finally, allow the space.
            compadd -S " " -- "$item"
        fi
    else
        # Multiple matches: show them, but don't add a space or dot yet.
        compadd -S "" -n -a matches
    fi
}

_volpy() {
    _arguments -C \
        '-f[Input image file]:image file:_files' \
        '-o[Output directory]:directory:_files -/' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*-v[Verbosity]' \
        '*:plugins:_vol_plugins'
}

_volpy "$@"