#compdef vol.py /opt/volatility3/vol.py

_vol_plugins() {
    local -a plugins matches
    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | awk '/^  +[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+/ {print $1}' | sed 's/\.$//'))
    fi

    # _multi_parts -i -S "." -q . _vol_plugin_list

    local cur="${words[CURRENT]}"

    # Logic to handle the "already completed" state
    # If the user types 'linux' and hits tab, we want 'linux.'
    if [[ -n "${_vol_plugin_list[(r)$cur.*]}" && "$cur" != *.* ]]; then
        compadd -S "." -q -- "$cur"
        return
    fi

    # Standard completion logic for sub-levels
    compset -P "*."
    
    for p in $_vol_plugin_list; do
        if [[ "$p" == "$IPREFIX"* ]]; then
            local rest="${p#$IPREFIX}"
            matches+=("${rest%%.*}")
        fi
    done

    matches=(${(u)matches})

    if (( ${#matches} == 1 )); then
        local item="$matches[1]"
        # If there is another level, add a dot. 
        # If not, add a space.
        if [[ -n "${(M)_vol_plugin_list:#$IPREFIX$item.*}" ]]; then
            compadd -S "." -q -- "$item"
        else
            compadd -S " " -- "$item"
        fi
    else
        # Multiple possibilities
        compadd -a matches
    fi
}

_volpy() {
    _arguments -C \
        '-f[Input image file]:image file:_files' \
        '-o[Output directory]:directory:_files -/' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*-v[Verbosity]' \
        '*:plugins:_vol_plugins'
}

_volpy "$@"