#compdef vol.py

_vol_plugins() {
    local -a plugins
    local cur_prefix="${words[CURRENT]}"

    if [[ "$cur_prefix" == -* ]]; then
        _arguments '-f[file]' '-h[help]' '--help'
        return
    fi

    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | grep -E '^[a-zA-Z0-9_]+\.' | awk '{print $1}'))
    fi

    _multi_parts -S "." . _vol_plugin_list
}

_vol_plugins "$@"