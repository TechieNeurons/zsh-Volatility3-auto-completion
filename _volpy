#compdef vol.py /opt/volatility3/vol.py

_vol_plugins() {
    local -a plugins matches
    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | awk '/^  +[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+/ {print $1}' | sed 's/\.$//'))
    fi

    # _multi_parts -i -S "." -q . _vol_plugin_list

    # 2. This is the fix for the "freeze": 
    # It tells Zsh to treat everything before the last dot as "already done"
    compset -P "*."

    # 3. Get what we have typed AFTER the last dot
    local cur="${words[CURRENT]}"
    # IPREFIX contains everything before the dot (e.g., "linux.")
    # PREFIX contains what we are currently typing (e.g., "mal")

    for p in $_vol_plugin_list; do
        if [[ "$p" == "$IPREFIX"* ]]; then
            # Extract only the next part
            local rest="${p#$IPREFIX}"
            matches+=("${rest%%.*}")
        fi
    done

    matches=(${(u)matches})

    # 4. Handle Suffixes (Dot vs Space)
    if (( ${#matches} == 1 )); then
        local item="$matches[1]"
        # If there is another dot in the full path after this item, add a dot
        if [[ -n "${(M)_vol_plugin_list:#$IPREFIX$item.*}" ]]; then
            compadd -S "." -q -- "$item"
        else
            # Final level: add a space
            compadd -S " " -- "$item"
        fi
    else
        # Multiple matches (e.g., check_afinfo, check_creds)
        compadd -a matches
    fi
}

_volpy() {
    _arguments -C \
        '-f[Input image file]:image file:_files' \
        '-o[Output directory]:directory:_files -/' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*-v[Verbosity]' \
        '*:plugins:_vol_plugins'
}

_volpy "$@"