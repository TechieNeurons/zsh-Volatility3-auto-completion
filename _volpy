#compdef vol.py /opt/volatility3/vol.py

_vol_plugins() {
    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | awk '/^  +[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+/ {print $1}' | sed 's/\.$//'))
    fi

    # _multi_parts -i -S "." -q . _vol_plugin_list

# 2. Tell Zsh that we are completing a string separated by dots
    # This allows Zsh to handle the 'li -> linux' part naturally
    local sep="."
    compset -P "*$sep"

    # 3. Filter the list based on what is already typed before the last dot
    local prefix="${IPREFIX}"
    local -a choices
    local -a full_matches
    
    for p in $_vol_plugin_list; do
        if [[ "$p" == "$prefix"* ]]; then
            # Get the next part after the current prefix
            local rest="${p#$prefix}"
            local next_part="${rest%%.*}"
            choices+=("$next_part")
            full_matches+=("$p")
        fi
    done
    
    # Remove duplicates
    choices=(${(u)choices})

    # 4. Logic for Dot vs Space
    if (( ${#choices} == 1 )); then
        local item="$choices[1]"
        # Check if this specific match has more levels in any plugin
        if [[ -n "${full_matches[(r)$prefix$item.*]}" ]]; then
            # There are deeper levels: add dot, but keep the suffix 'quiet'
            compadd -S "." -q -- "$item"
        else
            # This is the leaf: add a space
            compadd -S " " -- "$item"
        fi
    else
        # Multiple choices (e.g., windows.malware vs windows.registry)
        # Add no suffix so the user can keep typing
        compadd -S "" -- "$choices"
    fi
}

_volpy() {
    _arguments -C \
        '-f[Input image file]:image file:_files' \
        '-o[Output directory]:directory:_files -/' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*-v[Verbosity]' \
        '*:plugins:_vol_plugins'
}

_volpy "$@"