#compdef vol.py /opt/volatility3/vol.py

_vol_plugins() {
    local -a plugins matches
    if [[ -z "$_vol_plugin_list" ]]; then
        _vol_plugin_list=($(/opt/volatility3/vol.py --help | awk '/^  +[a-zA-Z0-9_]+\.[a-zA-Z0-9_.]+/ {print $1}' | sed 's/\.$//'))
    fi

    # _multi_parts -i -S "." -q . _vol_plugin_list

    # Handle the "dots" as separators properly
    local cur="${words[CURRENT]}"
    
    # 1. If there's a dot, tell Zsh to ignore everything before the last dot
    compset -P "*."

    # 2. Filter the plugins based on the prefix (including dots we've typed)
    # IPREFIX is the part handled by compset -P (e.g., "linux.")
    for p in $_vol_plugin_list; do
        if [[ "$p" == "$IPREFIX"* ]]; then
            local rest="${p#$IPREFIX}"
            matches+=("${rest%%.*}")
        fi
    done

    matches=(${(u)matches})

    # 3. CRITICAL FIX: Determine suffix behavior
    if (( ${#matches} == 1 )); then
        local item="$matches[1]"
        # Check if there's another level after this word
        if [[ -n "${(M)_vol_plugin_list:#$IPREFIX$item.*}" ]]; then
            # Use -S "." to force the dot and -q so it's removable.
            # -n means "don't add a space"
            compadd -S "." -q -n -- "$item"
        else
            # This is the actual end of a plugin name
            compadd -S " " -- "$item"
        fi
    else
        # Show multiple possibilities; don't add anything yet
        compadd -S "" -n -a matches
    fi
}

_volpy() {
    _arguments -C \
        '-f[Input image file]:image file:_files' \
        '-o[Output directory]:directory:_files -/' \
        '-h[Show help]' \
        '--help[Show help]' \
        '*-v[Verbosity]' \
        '*:plugins:_vol_plugins'
}

_volpy "$@"